{
  "name": "telegram-bot-clean-architecture",
  "version": "1.0.0",
  "description": "Telegram bot built with Telegraf.js and Clean Architecture",
  "main": "dist/main.js",
  "type": "commonjs",
  "scripts": {
    "build": "tsc",
    "build:clean": "rm -rf dist && tsc && cp -r src/public dist/public",
    "start": "node dist/main.js",
    "start-with-setup": "sh check-ffmpeg.sh && npm run dev",
    "dev": "ts-node-dev --respawn --transpile-only src/main.ts"
  },
  "keywords": [
    "telegram",
    "bot",
    "telegraf",
    "clean-architecture"
  ],
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "@distube/ytdl-core": "^4.16.12",
    "@xct007/tiktok-scraper": "^1.0.2",
    "@vercel/node": "^3.0.0",
    "dotenv": "^16.4.5",
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "node-fetch": "^3.3.2",
    "sharp": "^0.34.5",
    "telegraf": "^4.16.3",
    "tiktok-downloader": "^0.0.4",
    "ytdl-core": "^4.11.5"
  },
  "devDependencies": {
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/jest": "^30.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.12.12",
    "@types/node-fetch": "^2.6.13",
    "jest": "^30.3.0",
    "ts-jest": "^29.4.9",
    "ts-node-dev": "^2.0.0",
    "typescript": "^6.0.3"
  }
}
